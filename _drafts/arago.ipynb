    "import numpy as np\n",
    "import scipy as sp\n",
    "def P(r, r1):\n",
    "    n = np.linalg.norm(r)\n",
    "    return np.exp(1.j * n) / n\n",
    "\n",
    "def P(r):\n",
    "    def psi(r1):\n",
    "        return P(r, r1)\n",
    "    return psi\n",
    "\n"
